# Kept out of the archive Composer downloads. Consumers get src/ and the
# package metadata; the 7MB schema, the tooling and the tests are for us.
/openapi.json export-ignore
/api-surface.txt export-ignore
/oasdiff-severity.txt export-ignore
/.openapi-generator export-ignore
/.openapi-generator-ignore export-ignore
/.github export-ignore
/scripts export-ignore
/templates export-ignore
/tests export-ignore
/Makefile export-ignore
/phpunit.xml.dist export-ignore
/CONTRIBUTING.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
