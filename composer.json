{
    "name": "incident-io/sdk-php",
    "description": "PHP client for the incident.io API, generated from the published OpenAPI schema.",
    "type": "library",
    "keywords": ["incident.io", "incident", "on-call", "api", "sdk"],
    "homepage": "https://github.com/incident-io/sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "incident.io",
            "homepage": "https://incident.io"
        }
    ],
    "support": {
        "issues": "https://github.com/incident-io/sdk-php/issues",
        "docs": "https://api-docs.incident.io/"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "IncidentIo\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "IncidentIo\\Tests\\": "tests/" }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
